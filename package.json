{
  "name": "pdf-tutor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixture": "node --experimental-strip-types scripts/make-fixture.ts",
    "decks": "node --experimental-strip-types scripts/make-decks.ts",
    "eval": "node --experimental-strip-types scripts/eval/run.ts",
    "ground": "node --experimental-strip-types scripts/ground.ts",
    "reports": "node --experimental-strip-types scripts/reports.ts",
    "corpus-profile": "node --expose-gc --max-old-space-size=8192 --experimental-strip-types scripts/corpus/profile.ts",
    "corpus-bench": "node --experimental-strip-types scripts/corpus/browserBench.ts",
    "ctx-bench": "node --max-old-space-size=8192 --experimental-strip-types scripts/corpus/ctxBench.ts",
    "replay-stress": "node --import ./scripts/lib/tsResolve.mjs --experimental-transform-types --no-warnings scripts/eval/replayStress.ts",
    "gallery": "node --experimental-strip-types scripts/gallery/run.ts",
    "gate": "node --experimental-strip-types scripts/gate.ts"
  },
  "dependencies": {
    "katex": "0.18.11",
    "lucide-react": "^1.62.0",
    "pdfjs-dist": "^4.10.38",
    "perfect-freehand": "^1.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
