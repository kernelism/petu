OPENAI_API_KEY=
# Optional: asking by voice (speechmatics.com). Without it the mic button is hidden.
SPEECHMATICS_API_KEY=

# PETU_* knobs. These are normally set on the command line for a run
# (e.g. `PETU_PHASE=bakeoff npm run dev`), not here; the values below are the defaults.
# Process env wins over .env. server/env.ts validates them (a bad value stops the dev server).

# Which budget this process spends from: dev | bakeoff | iterate | validate | founder.
PETU_PHASE=founder
# Per-phase budgets in USD (plan §3). The dev contingency is run as PETU_CAP_DEV=3.
PETU_CAP_DEV=1
PETU_CAP_BAKEOFF=6
PETU_CAP_ITERATE=7
PETU_CAP_VALIDATE=2
PETU_CAP_FOUNDER=21.99
# Hard total for checkpoint 2, prior spike spend included. Max 40 (it can only be lowered).
PETU_TOTAL_CAP_USD=40
# Daily cap, founder phase only.
PETU_DAILY_CAP_USD=3
# Spend before the ledger existed (the LLM spike).
PETU_PRIOR_USD=0.0076

# Model for answers (the bake-off decides; see spec A1).
PETU_MODEL=gpt-6.1-terra
# Reasoning effort: none | low | medium | high (sol and astra need low or above).
PETU_EFFORT=none
# max_output_tokens per answer (also the worst-case reservation). Unset = 3200 (server/env.ts
# DEFAULT_MAX_OUTPUT); an svg answer often runs past 1400, so a lower value cuts answers off.
# PETU_MAX_OUTPUT=3200
# 1 = Fast mode (priority processing).
PETU_FAST=0
# text.verbosity: low | medium. Unset = the model's default.
PETU_VERBOSITY=
# 0 = no explicit cache breakpoints (prompt_cache_key only).
PETU_EXPLICIT_CACHE=1

# Dev-only: directories /api/dev-pdf may serve PDFs from (comma-separated; ~ allowed).
# Empty = ~/Documents/670/contents and public/dev. Never committed.
PETU_PDF_DIRS=
